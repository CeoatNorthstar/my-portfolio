# Local dev secrets for `wrangler pages dev`. Copy to `.dev.vars` (gitignored).
#
# Lets you reach the /admin UI locally WITHOUT a token or Cloudflare Access.
# NEVER set this in production.
DEV_ADMIN_BYPASS=true

# Stripe TEST secret key for local checkout testing (sk_test_...), used once
# donations are switched back on.
STRIPE_SECRET_KEY=
